# =============================================================================
# RAG Notebook — PRODUCTION environment
#
#   cp variables.env.example variables.env && chmod 600 variables.env
#
# IMPORTANT: pass this file explicitly on every compose command —
#   docker compose --env-file variables.env -f docker-compose.prod.yml up -d
# Compose only auto-reads `.env`. Without the flag, POSTGRES_PASSWORD,
# ACME_EMAIL and CLERK_SECRET_KEY are unresolved and compose refuses to start.
#
# Every value below is a real production credential. `variables.env` must be
# chmod 600 and must never be committed — add it to .gitignore.
#
# Values NOT listed here are set directly in docker-compose.prod.yml because
# they describe the stack's topology rather than a secret:
#   NODE_ENV, PORT, LOG_LEVEL, APP_URL, CLIENT_ORIGINS,
#   DATABASE_URL, QDRANT_URL, INNGEST_DEV
# Setting them here has no effect — compose `environment:` wins over `env_file`.
# =============================================================================

# -----------------------------------------------------------------------------
# Traefik / TLS
# -----------------------------------------------------------------------------
# Let's Encrypt uses this for expiry notices. Must be a mailbox you read.
ACME_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Postgres
# The compose file builds DATABASE_URL from these three values.
# Generate the password with: openssl rand -base64 32
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=rag_notebook

# Optional server-side pool tuning.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Clerk — PRODUCTION instance
#
# Use the keys from your Clerk *production* instance, not development:
#   publishable key starts with pk_live_
#   secret key      starts with sk_live_
# A pk_test_/sk_test_ pair here means Clerk runs in dev mode — sessions are
# capped, the dev banner shows, and satellite/domain checks are relaxed.
#
# In the Clerk dashboard for the production instance, set:
#   Domain             ragnotebookai.online   (add the DNS records it asks for)
#   Webhook endpoint   https://api.ragnotebookai.online/api/v1/webhooks/clerk
#     subscribe to user.created / user.updated / user.deleted, then copy the
#     signing secret into CLERK_WEBHOOK_SECRET below.
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# The client container reads CLERK_SECRET_KEY above at runtime. Its
# NEXT_PUBLIC_* values are baked into the JS bundle at BUILD time and CANNOT be
# changed from here — the image must be built with these build args:
#
#   docker build ./client \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.ragnotebookai.online/api/v1 \
#     --build-arg NEXT_PUBLIC_APP_URL=https://ragnotebookai.online \
#     --build-arg NEXT_PUBLIC_CONTRACT_VERSION=1.3.0 \
#     --build-arg NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me \
#     -t amantiwari7974/rag-notebook-client:v1
#
# If the pushed :v1 image was built with localhost values, the deployed site
# will call http://localhost:8080 from the user's browser and fail.

# -----------------------------------------------------------------------------
# Inngest — CLOUD (production) mode
#
# The server refuses to boot without both keys when NODE_ENV=production, and
# the compose file pins INNGEST_DEV=0 so it can never fall back to the local
# dev server.
#
# In the Inngest dashboard, on the PRODUCTION environment:
#   - create an Event Key and a Signing Key and paste them below
#   - sync the app at:  https://api.ragnotebookai.online/api/inngest
#     (this path is served outside /api/v1 — see src/inngest/serve.ts)
#
# INNGEST_EVENT_KEY must be a single URL path segment: no "/", "?", "#", spaces.
# -----------------------------------------------------------------------------
INNGEST_EVENT_KEY=replace_with_production_event_key
INNGEST_SIGNING_KEY=signkey-prod-replace_me

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-replace_me
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CLASSIFIER_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Qdrant
# QDRANT_URL is set by compose to the internal service. Set an API key to
# require auth even inside the private network — the same value is passed to
# the Qdrant container.
# -----------------------------------------------------------------------------
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_notebook_chunks

# -----------------------------------------------------------------------------
# Cloudinary (file uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_UPLOAD_FOLDER=rag-notebook

# -----------------------------------------------------------------------------
# Langfuse (observability)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-replace_me
LANGFUSE_SECRET_KEY=sk-lf-replace_me
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# External integrations
# -----------------------------------------------------------------------------
MEM0_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
YOUTUBE_API_KEY=
# Optional. Egress proxy used ONLY for YouTube caption fetches.
# YouTube serves a bot check ("Sign in to confirm you're not a bot") to datacenter
# IP ranges, so a deployed server generally needs a residential proxy here even
# though local development works without one. http(s):// or socks5:// URL.
YOUTUBE_PROXY_URL=

# -----------------------------------------------------------------------------
# Razorpay — LIVE mode
# Use live keys (rzp_live_...), not rzp_test_.
# Webhook endpoint: https://api.ragnotebookai.online/api/v1/webhooks/razorpay
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# -----------------------------------------------------------------------------
# Rate limiting (optional). Without it the server falls back to in-memory
# counters, which are per-container and reset on restart.
# -----------------------------------------------------------------------------
RATE_LIMIT_REDIS_URL=
