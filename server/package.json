{
  "name": "rag-notebook-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RAG Notebook — server. Owns the API contract, ingestion pipeline, and retrieval.",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:inngest": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "docs:api": "tsx scripts/docs-swagger.ts",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "check:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration"
  },
  "dependencies": {
    "@clerk/express": "^2.1.61",
    "@langfuse/client": "^5.10.1",
    "@langfuse/openai": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@mendable/firecrawl-js": "4.35.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@tavily/core": "^0.7.8",
    "cloudinary": "^2.10.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "googleapis": "^176.0.0",
    "helmet": "8.3.0",
    "inngest": "^4.18.1",
    "ioredis": "5.8.2",
    "mem0ai": "^3.1.7",
    "openai": "^7.5.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "razorpay": "^2.9.8",
    "svix": "^2.0.0",
    "unpdf": "1.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inngest/test": "^1.0.0",
    "@types/autocannon": "^7.12.7",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "26.2.0",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "globals": "17.11.0",
    "openapi-typescript": "7.13.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsc-alias": "^1.9.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
