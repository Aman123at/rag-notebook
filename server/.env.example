# =============================================================================
# RAG Notebook — server environment
# Copy to .env and fill in real values. The process refuses to boot on missing
# or malformed vars, reporting all problems at once via zod (src/config/env.ts).
# Nothing else in the codebase reads process.env directly.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_URL=http://localhost:3000
# Comma-separated list of origins allowed to hit the API from the browser.
CLIENT_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Postgres (Drizzle)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rag_notebook

# -----------------------------------------------------------------------------
# Clerk (auth + webhooks)
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# OpenAI (chat, embeddings, classifier)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CLASSIFIER_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Qdrant (vector store)
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_notebook_chunks

# -----------------------------------------------------------------------------
# Cloudinary (file uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=rag-notebook

# -----------------------------------------------------------------------------
# Inngest (background jobs)
# -----------------------------------------------------------------------------
# Derived from NODE_ENV: development/test -> local Dev Server, production -> cloud.
# Both keys are REQUIRED in production (env validation refuses to boot without them).
# The event key must be a single URL path segment - no "/", "?", "#" or spaces.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Optional override of the NODE_ENV derivation: 1 = dev server, 0 = cloud.
# INNGEST_DEV=

# -----------------------------------------------------------------------------
# Langfuse (observability)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# External integrations
# -----------------------------------------------------------------------------
MEM0_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
YOUTUBE_API_KEY=
# Optional. Egress proxy used ONLY for YouTube caption fetches.
# YouTube serves a bot check ("Sign in to confirm you're not a bot") to datacenter
# IP ranges, so a deployed server generally needs a residential proxy here even
# though local development works without one. http(s):// or socks5:// URL.
YOUTUBE_PROXY_URL=

# -----------------------------------------------------------------------------
# Razorpay (billing)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Rate limiting (optional; in-memory fallback in dev)
# -----------------------------------------------------------------------------
RATE_LIMIT_REDIS_URL=
